# Copy to .env for local testing (never commit the real key).
GROQ_API_KEY=gsk_your_existing_free_groq_key
GROQ_MODEL=whisper-large-v3-turbo
# Optional: lock CORS to your Salesforce domain(s), comma-separated.
# Leave blank to reflect any origin (fine for a stateless transcription relay).
ALLOWED_ORIGIN=
PORT=3000
